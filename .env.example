# Платформа заявок на перевозку — переменные окружения (пример)
# Скопируйте в .env и заполните значения.

# Адрес MongoDB. Для локальной разработки укажите DATABASE_URL так же,
# как контейнер MongoDB из docker-compose.yml (например через localhost:27017).
DATABASE_URL=mongodb://mongodb:27017/agrorunok

# For the Next.js app only (next/.env.local):
# DATABASE_URL=mongodb://127.0.0.1:27017/agrorunok
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=<2e93eb29-6c1e-4eae-b9cc-f053ce3fdc87>
